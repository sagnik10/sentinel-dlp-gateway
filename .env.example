# Generate a unique persistent value with secrets.token_urlsafe(64).
DJANGO_SECRET_KEY=replace-with-a-long-random-secret-before-deployment
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
# Set true on the client server behind a correctly configured HTTPS proxy.
DLP_REQUIRE_HTTPS=false
DLP_RATE_LIMIT=30
DLP_INTERNAL_KEYWORDS=TEST-ORION
DLP_INTERNAL_DOMAINS=corp.example,internal.example
DLP_ENABLE_LOCAL_CLASSIFIER=false
DLP_LOCAL_MODEL_PATH=
DLP_ENABLE_PRESIDIO=false
DLP_SPACY_MODEL=en_core_web_lg
